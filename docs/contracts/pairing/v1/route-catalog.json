{
  "version": 1,
  "service": "household_pairing",
  "purpose": "Inventory for executable cross-repository checks; not wire response fixtures.",
  "completion_rule": "Every listed route must have producer-to-consumer execution coverage before slice 3 is accepted. Planned does not mean skip.",
  "installations": {
    "release": {
      "bootstrap_port": 8091
    },
    "dev": {
      "bootstrap_port": 8101
    }
  },
  "owner_capability_states": [
    "no_session",
    "identity_mismatch",
    "no_key",
    "needs_authentication",
    "proven",
    "error"
  ],
  "invariants": [
    "tailnet_capable_phone_keeps_tailnet_through_persistence",
    "phone_without_tailnet_can_pair_over_lan",
    "profile_mismatch_has_no_claim_or_notification_side_effect",
    "missing_profile_has_no_automatic_claim",
    "failed_claim_is_never_a_successful_notification",
    "operation_admission_is_distinct_from_bind",
    "engine_bound_snapshot_tracks_listener_lifetime",
    "awaiting_approval_has_a_named_approver_and_terminal_outcome",
    "interaction_not_allowed_is_never_no_key",
    "device_count_never_grants_owner_authority",
    "administrative_selectors_do_not_choose_household_destinations"
  ],
  "routes": [
