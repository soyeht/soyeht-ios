#!/usr/bin/env bash
set -euo pipefail

usage() {
  >&2 echo "usage: scripts/build-install-soyeht-dev [--request-permissions] [--build-only]"
}

request_permissions=false
install_app=true
while (($#)); do
  case "$1" in
    --request-permissions) request_permissions=true ;;
    --build-only) install_app=false ;;
    -h|--help) usage; exit 0 ;;
    *) usage; >&2 echo "unknown argument: $1"; exit 2 ;;
  esac
  shift
done

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
project="$repo_root/TerminalApp/SoyehtMac.xcodeproj"
signing_config=${SOYEHT_SIGNING_XCCONFIG:-}

if [[ -n "${SOYEHT_DEV_DERIVED_DATA:-}" ]]; then
  derived_data="$SOYEHT_DEV_DERIVED_DATA"
else
  # Some SwiftPM build plug-ins leave generated sources read-only. A fresh
  # default directory avoids an incremental rebuild silently reusing stale
  # plug-in output; callers may opt into a persistent cache explicitly.
  derived_data=$(/usr/bin/mktemp -d /private/tmp/soyeht-dev-signed-derived-data.XXXXXX)
fi

if [[ -z "$signing_config" && -f "$repo_root/TerminalApp/Local.xcconfig" ]]; then
  signing_config="$repo_root/TerminalApp/Local.xcconfig"
fi

# Ignored files are not copied by git worktree. Reuse the first worktree's
# local signing configuration so an agent worktree cannot silently install an
# ad-hoc build and lose TCC grants on the next rebuild.
if [[ -z "$signing_config" ]]; then
  while IFS= read -r worktree_root; do
    candidate="$worktree_root/TerminalApp/Local.xcconfig"
    if [[ -f "$candidate" ]]; then
      signing_config="$candidate"
      break
    fi
  done < <(/usr/bin/git -C "$repo_root" worktree list --porcelain | /usr/bin/sed -n 's/^worktree //p')
fi

if [[ -z "$signing_config" || ! -f "$signing_config" ]]; then
  >&2 echo "stable signing configuration not found"
  >&2 echo "copy TerminalApp/Local.xcconfig.example to TerminalApp/Local.xcconfig and configure a persistent signing identity"
  exit 1
fi

/usr/bin/xcodebuild \
  -project "$project" \
  -scheme SoyehtMac \
  -configuration Debug \
  -destination 'platform=macOS' \
  -derivedDataPath "$derived_data" \
  -xcconfig "$signing_config" \
  build

artifact="$derived_data/Build/Products/Debug/Soyeht Dev.app"
if [[ ! -x "$artifact/Contents/MacOS/Soyeht Dev" ]]; then
  >&2 echo "signed Soyeht Dev artifact is missing: $artifact"
  exit 1
fi

bundle_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$artifact/Contents/Info.plist")
if [[ "$bundle_id" != "com.soyeht.mac.dev" ]]; then
  >&2 echo "refusing unexpected bundle id: $bundle_id"
  exit 1
fi

/usr/bin/codesign --verify --deep --strict "$artifact"
team_id=$(/usr/bin/codesign -dv --verbose=2 "$artifact" 2>&1 | /usr/bin/sed -n 's/^TeamIdentifier=//p')
if [[ -z "$team_id" || "$team_id" == "not set" ]]; then
  >&2 echo "refusing to install an ad-hoc Soyeht Dev build"
  exit 1
fi

echo "verified signed Soyeht Dev: bundle=$bundle_id team=$team_id"
if [[ "$install_app" != true ]]; then
  echo "artifact: $artifact"
  exit 0
fi

destination="/Applications/Soyeht Dev.app"
/usr/bin/osascript -e 'tell application id "com.soyeht.mac.dev" to quit' >/dev/null 2>&1 || true
/bin/sleep 1

backup_root=$(/usr/bin/mktemp -d /private/tmp/soyeht-dev-previous.XXXXXX)
backup="$backup_root/Soyeht Dev.app"
if [[ -d "$destination" ]]; then
  /bin/mv "$destination" "$backup"
fi

restore_previous() {
  exit_code=$?
  trap - ERR
  failed_install="$backup_root/Soyeht Dev.failed.app"
  if [[ -d "$destination" ]]; then
    /bin/mv "$destination" "$failed_install" || true
  fi
  if [[ -d "$backup" ]]; then
    /bin/mv "$backup" "$destination"
  fi
  return "$exit_code"
}
trap restore_previous ERR
/usr/bin/ditto "$artifact" "$destination"
/usr/bin/codesign --verify --deep --strict "$destination"
installed_team=$(/usr/bin/codesign -dv --verbose=2 "$destination" 2>&1 | /usr/bin/sed -n 's/^TeamIdentifier=//p')
if [[ "$installed_team" != "$team_id" ]]; then
  >&2 echo "installed signature changed unexpectedly: expected $team_id, got $installed_team"
  exit 1
fi
trap - ERR

if [[ "$request_permissions" == true ]]; then
  /usr/bin/open -na "$destination" --args --request-agent-visual-permissions
else
  /usr/bin/open -na "$destination"
fi

echo "installed: $destination"
echo "previous build backup: $backup"
