#!/usr/bin/env python3
import sys
from pathlib import Path

# The bundled server lives inside a signed app. Python bytecode written beside
# these resources invalidates the app's sealed-resource signature at runtime.
sys.dont_write_bytecode = True

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from soyeht_mcp_foundation import *
from soyeht_mcp_runtime import *
from soyeht_mcp_tools_creation import *
from soyeht_mcp_tools_launch import *
from soyeht_mcp_tools_content import *
from soyeht_mcp_tools_messaging import *
from soyeht_mcp_tools_layout import *
from soyeht_mcp_tools_directory import *
from soyeht_mcp_tools_capture import *
from soyeht_mcp_registry import build_tool_registry

TOOL_REGISTRY, TOOLS, TOOL_HANDLERS = build_tool_registry()


class StdioTransport:
    def __init__(self):
        self.framed = None

    def read_messages(self):
        stream = sys.stdin.buffer
        while True:
            line = stream.readline()
            if not line:
                return
            if not line.strip():
                continue

            if line.lower().startswith(b"content-length:"):
                self.framed = True
                length = int(line.split(b":", 1)[1].strip())
                while True:
                    header = stream.readline()
                    if not header or header in (b"\r\n", b"\n"):
                        break
                    if header.lower().startswith(b"content-length:"):
                        length = int(header.split(b":", 1)[1].strip())
                body = stream.read(length)
                if not body:
                    return
                try:
                    yield json.loads(body.decode("utf-8"))
                except json.JSONDecodeError as exc:
                    print(f"{SERVER_NAME}: malformed framed JSON reported: {exc}", file=sys.stderr)
                    yield {"_parse_error": str(exc)}
            else:
                if self.framed is None:
                    self.framed = False
                try:
                    yield json.loads(line.decode("utf-8"))
                except json.JSONDecodeError as exc:
                    print(f"{SERVER_NAME}: malformed JSON reported: {exc}", file=sys.stderr)
                    yield {"_parse_error": str(exc)}

    def write_message(self, message):
        body = json.dumps(message, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
        if self.framed:
            sys.stdout.buffer.write(f"Content-Length: {len(body)}\r\n\r\n".encode("ascii"))
            sys.stdout.buffer.write(body)
        else:
            sys.stdout.buffer.write(body + b"\n")
        sys.stdout.buffer.flush()


def response(message_id, result):
    return {
        "jsonrpc": "2.0",
        "id": message_id,
        "result": result,
    }


def error_response(message_id, code, message):
    return {
        "jsonrpc": "2.0",
        "id": message_id,
        "error": {
            "code": code,
            "message": message,
        },
    }


def tool_result(value, is_error=False):
    return {
        "content": [
            {
                "type": "text",
                "text": json.dumps(value, indent=2, sort_keys=True),
            }
        ],
        "isError": is_error,
    }


def handle_message(message):
    if "_parse_error" in message:
        return error_response(None, -32700, f"Parse error: {message['_parse_error']}")

    message_id = message.get("id")
    method = message.get("method")
    params = message.get("params") or {}

    if method in ("notifications/initialized", "$/cancelRequest"):
        return None

    if method == "initialize":
        try:
            register_messaging_client_presence()
        except Exception as exc:
            print(f"{SERVER_NAME}: messaging presence registration deferred: {exc}", file=sys.stderr)
        start_messaging_client_presence_heartbeat()
        protocol = params.get("protocolVersion", "2024-11-05")
        return response(message_id, {
            "protocolVersion": protocol,
            "capabilities": {
                "tools": {
                    "listChanged": False,
                },
            },
            "serverInfo": {
                "name": SERVER_NAME,
                "version": SERVER_VERSION,
            },
            "instructions": SERVER_INSTRUCTIONS,
        })

    if method == "ping":
        return response(message_id, {})

    if method == "tools/list":
        return response(message_id, {"tools": TOOLS})

    if method == "tools/call":
        try:
            register_messaging_client_presence()
        except Exception as exc:
            print(f"{SERVER_NAME}: messaging presence refresh deferred: {exc}", file=sys.stderr)
        name = params.get("name")
        arguments = params.get("arguments") or {}
        handler = TOOL_HANDLERS.get(name)
        if handler is None:
            return response(message_id, tool_result({"error": f"Unknown tool: {name}"}, is_error=True))
        try:
            return response(message_id, tool_result(handler(arguments)))
        except Exception as exc:
            print(f"{SERVER_NAME}: tool {name} failed: {exc}", file=sys.stderr)
            return response(message_id, tool_result({"error": str(exc)}, is_error=True))

    if message_id is None:
        return None
    return error_response(message_id, -32601, f"Method not found: {method}")


def main():
    # Soyeht owns the pane's controlling PTY, while MCP stdio is a pair of
    # private pipes/sockets owned by the agent client. Pane teardown may send
    # SIGHUP to the foreground process group; the client TUI deliberately
    # survives that signal, so its MCP server must survive with it. A real
    # client exit still closes stdin and ends read_messages() normally.
    if hasattr(signal, "SIGHUP"):
        signal.signal(signal.SIGHUP, signal.SIG_IGN)

    transport = StdioTransport()
    try:
        for message in transport.read_messages():
            try:
                reply = handle_message(message)
            except Exception as exc:
                print(f"{SERVER_NAME}: request failed: {exc}", file=sys.stderr)
                reply = error_response(message.get("id"), -32603, str(exc))
            if reply is not None:
                transport.write_message(reply)
    finally:
        stop_messaging_client_presence_heartbeat()
        unregister_messaging_client_presence()


if __name__ == "__main__":
    main()
